---
import Icon from './Icon.astro';
import { site, socials, whatsapp, whatsappLink, genres } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink pt-14 pb-28 md:pb-14">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <p class="font-display text-2xl font-semibold">Wander <span class="text-gold">Luiz</span></p>
      <p class="mt-3 max-w-xs text-sm text-muted">
        Cantor para eventos em {site.baseCity} e {site.region}. {genres.join(', ')}.
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-gold uppercase">Contato</p>
      <a href={whatsappLink()} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm text-cream/90 hover:text-gold">
        <Icon name="whatsapp" class="size-4" /> {whatsapp.display}
      </a>
    </div>
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-gold uppercase">Redes</p>
      <ul class="mt-3 space-y-2 text-sm">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener me" class="inline-flex items-center gap-2 text-cream/90 hover:text-gold">
              <Icon name={s.icon} class="size-4" /> {s.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-12 flex max-w-7xl flex-col justify-between gap-3 border-t border-line/60 px-4 pt-6 text-xs text-muted sm:flex-row sm:px-6 lg:px-8">
    <p>© {year} {site.name}. Todos os direitos reservados.</p>
    <a href="#" class="hover:text-gold">Voltar ao topo ↑</a>
  </div>
</footer>
