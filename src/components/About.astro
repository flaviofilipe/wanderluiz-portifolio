---
import { Image } from 'astro:assets';
import { site, genres, packages, allCities, eventTypes } from '../data/site';
import { fotos } from '../lib/images';

// Usa a primeira foto vertical da pasta; se não houver, a primeira foto.
const retrato = fotos.find((f) => f.src.height > f.src.width) ?? fotos[0];

const stats = [
  { value: String(genres.length), label: 'estilos musicais' },
  { value: String(packages.length), label: 'formatos de show' },
  { value: `${Math.floor(allCities.length / 10) * 10}+`, label: 'cidades atendidas' },
];
---

<section id="sobre" class="relative py-24 md:py-32" aria-labelledby="sobre-title">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-12 lg:gap-16 lg:px-8">
    {retrato && (
      <div class="relative md:col-span-5" data-reveal>
        <div class="absolute -inset-3 -z-10 rounded-[2rem] border border-gold/30 md:-inset-4" aria-hidden="true"></div>
        <Image
          src={retrato.src}
          alt={`${site.name} em apresentação ao vivo`}
          widths={[400, 640, 900]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
        />
      </div>
    )}

    <div class="md:col-span-7">
      <p class="eyebrow" data-reveal>Sobre</p>
      <h2 id="sobre-title" class="font-display mt-4 text-4xl leading-tight font-semibold md:text-6xl" data-reveal>
        Uma voz, <span class="italic font-normal text-gold">todos os ritmos</span>.
      </h2>

      <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted" data-reveal>
        {site.bio.map((p) => <p>{p}</p>)}
      </div>

      <dl class="mt-12 grid grid-cols-3 gap-4 border-t border-line pt-8" data-reveal>
        {stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-4xl font-semibold text-gold md:text-5xl">{s.value}</dd>
            <dd class="mt-1 text-sm text-muted">{s.label}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-10 text-sm text-muted" data-reveal>
        <span class="font-semibold text-cream">Eventos:</span> {eventTypes.join(' · ')}
      </p>
    </div>
  </div>
</section>
