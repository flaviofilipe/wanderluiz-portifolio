---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { packages, whatsappLink } from '../data/site';
import { fundo } from '../lib/images';

const bg = fundo(1);
---

<section id="shows" class="grain relative isolate overflow-hidden py-24 md:py-32" aria-labelledby="shows-title">
  {bg && (
    <Picture
      src={bg}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-20 size-full object-cover opacity-50"
    />
  )}
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink via-ink/85 to-ink" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow" data-reveal>Formatos de show</p>
      <h2 id="shows-title" class="font-display mt-4 text-4xl font-semibold md:text-6xl" data-reveal>
        Do acústico ao <span class="italic font-normal text-gold">palco completo</span>
      </h2>
      <p class="mt-6 text-lg text-muted" data-reveal>
        Seis formações para eventos particulares e públicos. Escolha a que combina com o seu
        espaço, público e estilo. O repertório é montado sob medida para o seu evento.
      </p>
    </div>

    <ol class="mt-14 grid items-start gap-5 md:grid-cols-2 lg:grid-cols-3">
      {packages.map((p, i) => (
        <li id={p.slug} class="scroll-mt-24" data-reveal style={`--delay:${(i % 3) * 90}ms`}>
          <details class="pkg group/pkg rounded-2xl border border-line bg-surface/80 backdrop-blur-sm transition-colors hover:border-gold/50 open:border-gold/60 open:bg-surface-2">
            <summary class="flex cursor-pointer flex-col gap-4 p-6 md:p-7">
              <div class="flex items-start justify-between gap-4">
                <span class="font-display text-5xl leading-none font-light text-gold/80" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="pkg-icon flex size-10 shrink-0 items-center justify-center rounded-full border border-line text-gold group-hover/pkg:border-gold">
                  <Icon name="plus" class="size-5" />
                </span>
              </div>
              <div>
                <p class="text-xs font-semibold tracking-[0.18em] text-gold uppercase">{p.kicker}</p>
                <h3 class="font-display mt-2 text-2xl font-semibold md:text-[1.7rem]">{p.name}</h3>
                <p class="mt-3 leading-relaxed text-muted">{p.description}</p>
              </div>
              <span class="text-sm font-semibold text-cream/80 underline decoration-gold/50 underline-offset-4 group-open/pkg:hidden">
                Ver detalhes
              </span>
            </summary>

            <div class="border-t border-line px-6 pt-5 pb-7 md:px-7">
              <p class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Ideal para</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {p.idealFor.map((t) => (
                  <li class="rounded-full bg-gold/10 px-3 py-1 text-xs font-medium text-gold-soft">{t}</li>
                ))}
              </ul>
              <ul class="mt-5 space-y-2.5">
                {p.details.map((d) => (
                  <li class="flex gap-3 text-sm text-cream/90">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
                    {d}
                  </li>
                ))}
              </ul>
              <a
                href={whatsappLink(`Olá, Wander! Vim pelo site e quero um orçamento para o formato "${p.name}". Data: ___ · Cidade: ___ · Tipo de evento: ___`)}
                target="_blank"
                rel="noopener"
                class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gold px-5 py-3.5 text-sm font-semibold text-ink transition hover:bg-gold-soft"
              >
                <Icon name="whatsapp" class="size-4" /> Consultar disponibilidade
              </a>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>
