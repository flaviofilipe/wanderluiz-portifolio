---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site, socials, whatsapp, whatsappLink } from '../data/site';
import { fundo } from '../lib/images';

const bg = fundo(2);
---

<section id="contato" class="grain relative isolate overflow-hidden py-28 md:py-40" aria-labelledby="contato-title">
  {bg && (
    <Picture
      src={bg}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-20 size-full object-cover"
    />
  )}
  <div class="absolute inset-0 -z-10 bg-ink/75" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink via-transparent to-ink" aria-hidden="true"></div>

  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <p class="eyebrow justify-center" data-reveal>Contato</p>
    <h2 id="contato-title" class="font-display mt-5 text-5xl leading-[1.02] font-semibold md:text-7xl" data-reveal>
      Vamos fazer o seu evento <span class="italic font-normal text-gold">inesquecível</span>?
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg text-cream/85" data-reveal>
      Envie a data, a cidade e o tipo de evento pelo WhatsApp. O retorno é rápido, com
      disponibilidade e a melhor formação para você.
    </p>

    <div class="mt-10 flex flex-col items-center gap-4" data-reveal>
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-3 rounded-full bg-gold px-9 py-5 text-lg font-semibold text-ink shadow-[0_15px_50px_-12px_rgba(212,166,74,0.7)] transition hover:-translate-y-0.5 hover:bg-gold-soft"
      >
        <Icon name="whatsapp" class="size-6" /> Chamar no WhatsApp
      </a>
      <a href={`tel:+${whatsapp.number}`} class="text-sm text-cream/80 hover:text-gold">
        {whatsapp.display}
      </a>
    </div>

    <ul class="mt-12 flex items-center justify-center gap-3" aria-label="Redes sociais" data-reveal>
      {socials.map((s) => (
        <li>
          <a
            href={s.url}
            target="_blank"
            rel="noopener me"
            class="flex size-12 items-center justify-center rounded-full border border-cream/25 bg-ink/40 backdrop-blur-sm transition hover:border-gold hover:text-gold"
            aria-label={`${site.name} no ${s.name}`}
          >
            <Icon name={s.icon} class="size-5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
