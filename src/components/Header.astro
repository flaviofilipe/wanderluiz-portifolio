---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';

const links = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#videos', label: 'Vídeos' },
  { href: '#shows', label: 'Formatos de show' },
  { href: '#galeria', label: 'Galeria' },
  { href: '#contato', label: 'Contato' },
];
---

<header
  id="topo"
  class="group fixed inset-x-0 top-0 z-50 transition-colors duration-300 data-[scrolled]:border-b data-[scrolled]:border-line/60 data-[scrolled]:bg-ink/85 data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 md:h-20 lg:px-8">
    <a href="#" class="font-display text-xl font-semibold tracking-tight md:text-2xl" aria-label={`${site.name}, voltar ao início`}>
      Wander <span class="text-gold">Luiz</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-sm font-medium text-cream/80">
        {links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-gold">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-full bg-gold px-5 py-2.5 text-sm font-semibold text-ink transition hover:bg-gold-soft sm:inline-flex"
      >
        <Icon name="whatsapp" class="size-4" />
        Fazer orçamento
      </a>
      <button
        type="button"
        id="menu-btn"
        class="inline-flex size-11 items-center justify-center rounded-full border border-line text-cream lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    aria-label="Menu"
    class="hidden border-t border-line/60 bg-ink/95 backdrop-blur-md lg:hidden"
  >
    <ul class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block border-b border-line/40 py-4 font-display text-2xl">{l.label}</a>
        </li>
      ))}
      <li class="pt-5">
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 rounded-full bg-gold px-5 py-3.5 font-semibold text-ink"
        >
          <Icon name="whatsapp" class="size-5" /> Fazer orçamento no WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('topo')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu-mobile')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24 || !menu.classList.contains('hidden'));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    onScroll();
  };
  btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
      setOpen(false);
      btn.focus();
    }
  });
</script>
